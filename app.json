{
  "expo": {
    "name": "TaskRabbit Clone",
    "slug": "taskrabbit-clone",
    "scheme": "taskrabbitclone",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.taskrabbitclone",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location to show tasks near you and let taskers find nearby jobs."
      }
    },
    "android": {
      "package": "com.example.taskrabbitclone",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "We use your location to show tasks near you and let taskers find nearby jobs."
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow access to your photos to add a picture to your profile or task."
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
