{
  "name": "siza",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "test:db": "node --test \"tests/db/*.test.mjs\"",
    "icons": "node scripts/generate-icons.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:db"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.45.4",
    "@tanstack/react-query": "^5.56.2",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-location": "~58.0.20",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-postgis": "^0.2.16",
    "@expo/ngrok": "^4.1.3",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/tests/unit/**/*.test.ts"
    ],
    "clearMocks": true
  }
}
