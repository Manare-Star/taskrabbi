# Supabase project settings (Project Settings > API in the Supabase dashboard)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Payments go through Paystack and need no key in the app. Set the Paystack secret key as a
# Supabase Edge Function secret (Edge Functions > Secrets), NEVER here or anywhere in the app:
#   PAYSTACK_SECRET_KEY=sk_test_your_key
