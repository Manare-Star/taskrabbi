# Supabase project settings (Project Settings > API in the Supabase dashboard)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Stripe publishable key (test mode) - safe to expose in the client
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key

# Set as a Supabase Edge Function secret, NEVER in the app or this file with a real value:
#   supabase secrets set STRIPE_SECRET_KEY=sk_test_your_key
